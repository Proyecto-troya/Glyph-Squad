{
  "$defs": {
    "ChatMessage": {
      "additionalProperties": false,
      "description": "Spec ChatMessage plus ``thinking`` (assistant) and ``tool_name`` (tool results).",
      "properties": {
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "images": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Images"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "thinking": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolCall"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        }
      },
      "required": [
        "role"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "ModelOptions": {
      "additionalProperties": true,
      "description": "Runtime options. Ollama accepts more keys than the spec lists, so extras pass through.",
      "properties": {
        "min_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min P"
        },
        "num_ctx": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Ctx"
        },
        "num_predict": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Predict"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "stop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_k": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "ModelOptions",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "``type`` and ``function.index`` come from the tool-calling guide, not the spec.",
      "properties": {
        "function": {
          "$ref": "#/$defs/ToolCallFunction"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "function"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolCallFunction": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolCallFunction",
      "type": "object"
    },
    "ToolDefinition": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "$ref": "#/$defs/ToolFunctionDefinition"
        },
        "type": {
          "const": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "function"
      ],
      "title": "ToolDefinition",
      "type": "object"
    },
    "ToolFunctionDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolFunctionDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "anyOf": [
        {
          "const": "json",
          "type": "string"
        },
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Format"
    },
    "keep_alive": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Keep Alive"
    },
    "logprobs": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logprobs"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ChatMessage"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "model": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Model",
      "type": "string"
    },
    "options": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelOptions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stream": {
      "default": true,
      "title": "Stream",
      "type": "boolean"
    },
    "think": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Think"
    },
    "tools": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ToolDefinition"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tools"
    },
    "top_logprobs": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Top Logprobs"
    }
  },
  "required": [
    "model",
    "messages"
  ],
  "title": "ChatPayload",
  "type": "object"
}

# Leaf Plate gateway. Every value is read from the environment only (prefix GATEWAY_).
# Copy to .env, fill in, then:  set -a; source .env; set +a; python -m gateway
# Never commit a real token.

# Required. Clients send it as X-Gateway-Token or as subprotocol gateway.token.<token>.
GATEWAY_TOKEN=change-me

# Where uvicorn listens. 127.0.0.1 = this laptop only. Set the laptop's LAN IP for the demo.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765

# The only upstream. IP literal only; any hostname, even the loopback name, is rejected.
GATEWAY_OLLAMA_URL=http://127.0.0.1:11434
GATEWAY_UPSTREAM_CONNECT_TIMEOUT_S=5

# Browser clients must send one of these Origins. Non-browser clients send none and pass.
# Comma separated, e.g. https://192.168.1.20:5173,http://192.168.1.20:5173
GATEWAY_ALLOWED_ORIGINS=

# Size limits in bytes. Requests that carry images use the second one (base64 adds ~33%).
GATEWAY_MAX_MESSAGE_BYTES=1048576
GATEWAY_MAX_IMAGE_MESSAGE_BYTES=33554432

# Per-socket concurrency and per-request timeout. Keep concurrency within what
# OLLAMA_NUM_PARALLEL and OLLAMA_MAX_QUEUE allow on the Ollama side.
GATEWAY_MAX_CONCURRENT_PER_SOCKET=4
GATEWAY_REQUEST_TIMEOUT_S=600

# Protocol-level heartbeat, applied to uvicorn.
GATEWAY_WS_PING_INTERVAL_S=20
GATEWAY_WS_PING_TIMEOUT_S=20

# Directory that blob_upload may read GGUF files from. Unset disables blob_upload.
GATEWAY_IMPORT_DIR=

# Allowlist. Default covers the demo; create, blob_exists, blob_upload, copy, delete,
# pull and push are opt-in. pull/push need internet; push needs an ollama.com sign-in.
GATEWAY_ENABLED_ACTIONS=version,list,show,ps,load,unload,generate,chat,embed,systemone,ping

# wss: paths to a local certificate and key. Leave empty for ws.
GATEWAY_SSL_CERTFILE=
GATEWAY_SSL_KEYFILE=

GATEWAY_LOG_LEVEL=INFO
GATEWAY_CACHE_TTL_S=60

# Use case 2: keep a phrase only when the systemone noul probability is above this.
GATEWAY_BACKTRANSLATION_THRESHOLD=0.8

# POST /api/sms: one validated Spanish sentence appended to the app's LP code line.
# Falls back to a fixed template on timeout, validation failure or an unreachable model.
GATEWAY_SMS_ENABLED=true
GATEWAY_SMS_MODEL=llama3.2:3b
GATEWAY_SMS_TIMEOUT_S=10
GATEWAY_SMS_KEEP_ALIVE=30m
GATEWAY_SMS_SEED=7
GATEWAY_SMS_NUM_PREDICT=80
GATEWAY_SMS_MAX_CHARS=160
